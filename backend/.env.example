# Copy to backend/.env (gitignored) and fill in. Real environment variables win over this file.

# Hub identity: topics are home/<PS_HUB_ID>/{status,telemetry,event,cmd,ack}.
# Must be random on a public broker (serve/sim refuse a guessable one). Same value as
# HUB_ID in the firmware's Secrets.h. Generate:
#   python -c "import secrets; print('ps-' + secrets.token_hex(8))"
PS_HUB_ID=

# Shared bearer token. Must equal API_TOKEN in the firmware's Secrets.h. Max 64 chars.
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
PS_API_TOKEN=

# Broker. Leave these unset for the default: shiftr.io's public broker over a secure
# WebSocket on port 443, which works on networks that block MQTT's ports.
# Check the network with: python -m presencesense netcheck
#
# Local broker instead (amqtt -c broker.yaml):
#   PS_MQTT_HOST=127.0.0.1        (port 1883, plain TCP, no TLS follow automatically)
#
# All options: PS_MQTT_HOST, PS_MQTT_PORT, PS_MQTT_TRANSPORT (tcp | websockets),
# PS_MQTT_WS_PATH, PS_MQTT_TLS, PS_MQTT_CA_FILE, PS_MQTT_USERNAME, PS_MQTT_PASSWORD

# Hub REST control plane (LAN only, plain HTTP). Empty disables the REST transport.
# With the simulator: python -m presencesense sim --rest-port 8081  ->  http://127.0.0.1:8081
PS_DEVICE_URL=

PS_DB_PATH=presencesense.db
PS_WEB_HOST=127.0.0.1
PS_WEB_PORT=5000
# Exact origin allowed by CORS (and by the hub's Access-Control-Allow-Origin).
PS_DASHBOARD_ORIGIN=http://localhost:5000

# Energy model
PS_LAMP_A_WATTS=9
PS_LAMP_B_WATTS=9
PS_HUB_WATTS=0.25

# Rule engine
PS_STUCK_WINDOW_S=600
PS_STUCK_DISTANCE_CEILING_CM=1.0
PS_RETENTION_DAYS=30
